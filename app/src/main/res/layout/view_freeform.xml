<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/bg_freeform_frame_border"
    app:cardCornerRadius="@dimen/freeform_corner_radius"
    app:cardElevation="10dp"
    app:cardBackgroundColor="@color/color_surface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topBarView"
            android:tag="topBarView"
            android:layout_width="0dp"
            android:layout_height="@dimen/top_bar_height"
            android:background="@drawable/color_background"
            android:contentDescription="@string/freeform_drag_window"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/appIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:tag="appIcon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/packageName"
                android:tag="packageName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:fontFamily="google-sans-flex"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="@color/color_text_secondary"
                app:layout_constraintStart_toEndOf="@id/appIcon"
                app:layout_constraintEnd_toStartOf="@id/topDragHandle"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <View
                android:id="@+id/topDragHandle"
                android:tag="topDragHandle"
                android:layout_width="@dimen/drag_handle_width"
                android:layout_height="@dimen/drag_handle_height"
                android:alpha="0.88"
                android:importantForAccessibility="no"
                android:background="@drawable/bg_drag_handle_pill"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <View
                android:id="@+id/spacer"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:importantForAccessibility="no"
                android:tag="spacer"
                app:layout_constraintStart_toEndOf="@id/topDragHandle"
                app:layout_constraintEnd_toStartOf="@id/pinView"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- 44x48dp interactive hit containers around crisp 32x28dp M3 Expressive tonal pills -->
            <FrameLayout
                android:id="@+id/pinView"
                android:tag="pinView"
                android:layout_width="44dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/freeform_pin_window"
                app:layout_constraintEnd_toStartOf="@id/maximizeView"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:id="@+id/pinIcon"
                    android:tag="pinIcon"
                    android:layout_width="32dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:padding="6dp"
                    android:background="@drawable/bg_window_btn_pill"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_pin" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/maximizeView"
                android:tag="maximizeView"
                android:layout_width="44dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/freeform_maximize_window"
                app:layout_constraintEnd_toStartOf="@id/minimizeView"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:id="@+id/maximizeIcon"
                    android:tag="maximizeIcon"
                    android:layout_width="32dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:padding="6dp"
                    android:background="@drawable/bg_window_btn_pill"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_maximize" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/minimizeView"
                android:tag="minimizeView"
                android:layout_width="44dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/freeform_close_window"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:id="@+id/closeIcon"
                    android:tag="closeIcon"
                    android:layout_width="32dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:padding="6dp"
                    android:background="@drawable/bg_window_btn_close_pill"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_minimize" />
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <FrameLayout
            android:id="@+id/freeform_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="freeform_root"
            app:layout_constraintBottom_toTopOf="@+id/bottomBar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/topBarView" />

        <FrameLayout
            android:id="@+id/veilView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/color_veil_surface"
            android:tag="veilView"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@+id/bottomBar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/topBarView">

            <FrameLayout
                android:id="@+id/veilIconContainer"
                android:tag="veilIconContainer"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_veil_icon_container">

                <ImageView
                    android:id="@+id/veilAppIcon"
                    android:tag="veilAppIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter" />
            </FrameLayout>
        </FrameLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottomBar"
            android:layout_width="0dp"
            android:layout_height="@dimen/bottom_bar_height"
            android:background="@drawable/color_background"
            android:gravity="center"
            android:tag="bottomBarView"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:id="@+id/leftScale"
                android:layout_width="@dimen/scale_width"
                android:layout_height="0dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/freeform_resize_left"
                android:gravity="center"
                android:orientation="horizontal"
                android:tag="leftScaleView"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <View
                    android:layout_width="16dp"
                    android:layout_height="4dp"
                    android:importantForAccessibility="no"
                    android:background="@drawable/bar_corners_bg"
                    android:tag="leftScale" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/arrowBack"
                android:layout_width="56dp"
                android:layout_height="44dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/freeform_navigate_back"
                android:tag="arrowBack"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/guideline3"
                app:layout_constraintStart_toStartOf="@+id/guideline2"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:id="@+id/arrowBackPill"
                    android:tag="arrowBackPill"
                    android:layout_width="48dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_bottom_back_pill"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/arrowBackIcon"
                        android:tag="arrowBackIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_arrow_back" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/rightScale"
                android:layout_width="@dimen/scale_width"
                android:layout_height="0dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/freeform_resize_right"
                android:gravity="center"
                android:orientation="horizontal"
                android:tag="rightScaleView"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <View
                    android:layout_width="16dp"
                    android:layout_height="4dp"
                    android:importantForAccessibility="no"
                    android:background="@drawable/bar_corners_bg"
                    android:tag="rightScale" />
            </LinearLayout>

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.30"
                android:tag="guideline2" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.70"
                android:tag="guideline3" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
